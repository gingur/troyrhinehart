---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommitField from '../components/CommitField';
import HeroEffects from '../components/HeroEffects';
import ParticleImage from '../components/ParticleImage';
import { resume } from '../data/resume';

const description = `${resume.name} is a ${resume.title.toLowerCase()} building AI platforms, developer tooling, and web products at scale.`;

const companyDetails = [
  {
    logo: '/logos/attentive.png',
    color: '255,209,0',
    accent: 'yellow',
    label: 'Attentive',
    eyebrow: 'Agentic engineering at organizational scale',
    statement:
      'Building the platform and practices that make AI-assisted engineering useful, observable, and dependable for an entire organization.',
    gap: 3,
    dotRadius: 1.35,
  },
  {
    logo: '/logos/godaddy.png',
    color: '27,219,219',
    accent: 'cyan',
    label: 'GoDaddy',
    eyebrow: 'Thirteen years of products, platforms, and technical leadership',
    statement:
      'From the site builder behind millions of customer websites to a unified AI platform, the through-line was always leverage for the teams building next.',
    gap: 3,
    dotRadius: 1.35,
  },
  {
    logo: '/logos/village-voice.png',
    color: '237,28,36',
    accent: 'red',
    label: 'Village Voice Media',
    eyebrow: 'Where the production story began',
    statement:
      'Learning the whole lifecycle by shipping across the stack—and building shared identity infrastructure for thirteen regional publications.',
    gap: 2,
    dotRadius: 1,
  },
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: resume.name,
  jobTitle: resume.title,
  email: `mailto:${resume.email}`,
  url: new URL('/', Astro.site ?? Astro.url).href,
  sameAs: [resume.linkedin.href, 'https://github.com/gingur'],
  address: { '@type': 'PostalAddress', addressLocality: 'Mesa', addressRegion: 'AZ' },
  knowsAbout: [...resume.skills],
  alumniOf: resume.education.map((entry) => ({
    '@type': 'CollegeOrUniversity',
    name: entry.institution,
  })),
  worksFor: { '@type': 'Organization', name: resume.experience[0].company },
};

const arrow = `
  <svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
    <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`;
---

<BaseLayout title={`${resume.name} — ${resume.title}`} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <div class="site-shell">
    <header class="topbar">
      <a class="monogram" href="#top" aria-label="Troy Rhinehart, back to top">
        <span>TR</span><i aria-hidden="true"></i>
      </a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="#experience">Experience</a>
        <a href={`mailto:${resume.email}`}>Contact</a>
      </nav>
      <a class="nav-cta" href={resume.pdf} download={resume.pdfDownloadName}>
        Résumé <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <HeroEffects client:load />

        <div class="hero-topline reveal reveal-1">
          <p class="eyebrow">
            <span class="status-dot" aria-hidden="true"></span>
            Troy Rhinehart
          </p>
          <p>Principal Software Engineer</p>
          <p>Mesa, Arizona · 2010—Now</p>
        </div>

        <div class="hero-statement">
          <p class="hero-marker reveal reveal-2" aria-hidden="true">15+</p>
          <h1 id="hero-title" class="reveal reveal-2">
            I build the systems <em>behind ambitious products.</em>
          </h1>
        </div>

        <div class="hero-bottom reveal reveal-3">
          <p class="hero-intro">
            AI platforms, developer tooling, and web architecture that help teams turn complex
            ideas into dependable products at scale.
          </p>
          <div class="hero-focus" aria-label="Areas of focus">
            <span>AI orchestration</span>
            <span>Platforms</span>
            <span>Developer experience</span>
          </div>
          <div class="hero-actions">
            <a class="button button-primary" href="#experience">
              Explore the work <Fragment set:html={arrow} />
            </a>
            <a class="text-link" href={`mailto:${resume.email}`}>Start a conversation</a>
          </div>
        </div>
      </section>

      <section id="experience" class="experience-section" aria-label="Experience">
        <header class="experience-heading">
          <p class="section-index">01 / Experience</p>
          <p>Selected experience · 2010—Now</p>
        </header>

        <ol class="company-list">
          {
            resume.experience.map((job, index) => {
              const details = companyDetails[index]!;
              return (
                <li class={`company-chapter company-${details.accent}`}>
                  <div class="chapter-rail">
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <p>{job.dates}</p>
                  </div>

                  <figure class="company-visual">
                    <div class="particle-frame">
                      <ParticleImage
                        src={details.logo}
                        size={380}
                        gap={details.gap}
                        dotRadius={details.dotRadius}
                        color={details.color}
                        ariaLabel={`${details.label} particle logo`}
                        client:visible
                      />
                    </div>
                    <figcaption>Move through the mark</figcaption>
                  </figure>

                  <article class="company-story">
                    <p class="company-eyebrow">{details.eyebrow}</p>
                    <h3>{job.company}</h3>
                    <p class="company-role">{job.role}</p>
                    <p class="company-statement">{details.statement}</p>
                    <ul>
                      {job.highlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                    {'note' in job && job.note && <p class="company-note">{job.note}</p>}
                    <p class="company-location">{job.location}</p>
                  </article>
                </li>
              );
            })
          }
        </ol>
      </section>

      <section class="activity-section" aria-labelledby="activity-title">
        <header class="activity-heading">
          <p class="section-index">02 / Activity</p>
          <div>
            <h2 id="activity-title">The work <em>between the milestones.</em></h2>
            <p>
              A live signal from the day-to-day: public contribution activity combined across my
              GitHub identities.
            </p>
          </div>
        </header>
        <CommitField client:idle />
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <p class="section-index">03 / Next</p>
        <h2 id="closing-title">Let’s build the thing <em>behind the thing.</em></h2>
        <div>
          <a class="button button-primary" href={`mailto:${resume.email}`}>
            Email Troy <Fragment set:html={arrow} />
          </a>
          <a href={resume.linkedin.href} rel="me noopener" target="_blank">LinkedIn ↗</a>
        </div>
      </section>
    </main>

    <a
      class="resume-float"
      href={resume.pdf}
      rel="noopener"
      target="_blank"
      aria-label="Open résumé PDF"
    >
      <span class="resume-float-signal" aria-hidden="true"><i></i></span>
      <span><span class="resume-float-prefix">Download </span>Résumé</span>
      <span aria-hidden="true">↓</span>
    </a>

    <footer>
      <span>© {new Date().getFullYear()} Troy Rhinehart</span>
      <nav aria-label="Footer navigation">
        <a href={resume.pdf} download={resume.pdfDownloadName}>Résumé ↓</a>
        <a href="https://github.com/gingur" rel="me noopener" target="_blank">GitHub ↗</a>
        <a href="#top">Back to top ↑</a>
      </nav>
    </footer>
  </div>
</BaseLayout>
