---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmail from '../components/CopyEmail.tsx';
import { resume } from '../data/resume';

const description = `${resume.name} is a ${resume.title.toLowerCase()} building AI platforms, developer tooling, and web products at scale.`;

const metrics = [
  { value: '15+', label: 'years building for the web', accent: 'lime' },
  { value: '80%', label: 'faster CI pipelines', accent: 'violet' },
  { value: '80', label: 'AI models unified', accent: 'cyan' },
  { value: 'Millions', label: 'of sites powered', accent: 'orange' },
] as const;

const systems = [
  {
    number: '01',
    kicker: 'Agentic engineering',
    title: 'A shared operating system for AI-assisted development.',
    description:
      "Co-designed the orchestration platform used by every Attentive engineer—then built the standards, observability, and testing practices that make agentic work dependable.",
    tags: ['AI orchestration', 'Developer experience', 'Observability'],
    signal: 'org-wide',
  },
  {
    number: '02',
    kicker: 'Platform architecture',
    title: 'One integration point for an entire AI ecosystem.',
    description:
      "Architected GoDaddy's AI platform across 11 providers and 80 models, giving product teams a consistent foundation instead of a maze of vendor-specific integrations.",
    tags: ['11 providers', '80 models', 'Platform API'],
    signal: '80 models',
  },
  {
    number: '03',
    kicker: 'Product systems',
    title: 'The machinery behind millions of customer websites.',
    description:
      "Built the visual editor, publishing workflow, and extensible widget and theme architecture behind GoDaddy's Websites + Marketing product.",
    tags: ['WYSIWYG', 'Publishing', 'Extensible architecture'],
    signal: 'millions',
  },
] as const;

const principles = [
  {
    title: 'Make the path obvious',
    body: 'The best platform work removes decisions without removing power. Strong defaults, clear interfaces, and fast feedback keep teams moving.',
  },
  {
    title: 'Design for the next team',
    body: 'Architecture earns its keep when other engineers can extend it safely. Schemas, boundaries, and documentation are product features.',
  },
  {
    title: 'Turn reliability into leverage',
    body: 'Healthy tests and pipelines compound. Less time negotiating with infrastructure means more time spent solving customer problems.',
  },
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: resume.name,
  jobTitle: resume.title,
  email: `mailto:${resume.email}`,
  url: new URL('/', Astro.site ?? Astro.url).href,
  sameAs: [resume.linkedin.href, 'https://github.com/gingur'],
  address: { '@type': 'PostalAddress', addressLocality: 'Mesa', addressRegion: 'AZ' },
  knowsAbout: [...resume.skills],
  alumniOf: resume.education.map((entry) => ({
    '@type': 'CollegeOrUniversity',
    name: entry.institution,
  })),
  worksFor: { '@type': 'Organization', name: resume.experience[0].company },
};

const arrow = `
  <svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
    <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`;
---

<BaseLayout title={`${resume.name} — ${resume.title}`} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <div class="site-shell">
    <header class="topbar">
      <a class="monogram" href="#top" aria-label="Troy Rhinehart, back to top">
        <span>TR</span><i aria-hidden="true"></i>
      </a>

      <nav class="nav-links" aria-label="Primary navigation">
        <a href="#work">Systems</a>
        <a href="#experience">Experience</a>
        <a href="#principles">Principles</a>
      </nav>

      <a class="nav-cta" href={resume.pdf} download={resume.pdfDownloadName}>
        Résumé <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow reveal reveal-1">
            <span class="status-dot" aria-hidden="true"></span>
            Principal engineer · Mesa, Arizona
          </p>
          <h1 id="hero-title" class="reveal reveal-2">
            I make complex systems <em>feel inevitable.</em>
          </h1>
          <p class="hero-intro reveal reveal-3">
            I’m Troy, a principal software engineer who turns ambitious ideas into platforms teams
            can trust—from AI orchestration and developer tooling to web products used at massive
            scale.
          </p>
          <div class="hero-actions reveal reveal-4">
            <a class="button button-primary" href="#work">
              Explore my work <Fragment set:html={arrow} />
            </a>
            <a class="text-link" href={`mailto:${resume.email}`}>Start a conversation</a>
          </div>
        </div>

        <div class="system-map reveal reveal-3" data-glow aria-label="Career at a glance">
          <div class="map-grid" aria-hidden="true"></div>
          <div class="orbit orbit-one" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
          <div class="orbit orbit-two" aria-hidden="true"><i></i><i></i></div>
          <div class="map-core">
            <span class="map-label">Building since</span>
            <strong>2010</strong>
            <span class="map-caption">product · platform · people</span>
          </div>
          <div class="map-chip chip-ai"><span></span> AI systems</div>
          <div class="map-chip chip-dx"><span></span> Developer experience</div>
          <div class="map-chip chip-web"><span></span> Web platforms</div>
          <div class="map-readout" aria-hidden="true">
            <span>TR/SYSTEMS</span><span>ONLINE</span>
          </div>
        </div>
      </section>

      <div class="ticker" aria-label="Areas of expertise">
        <div>
          <span>Agentic engineering</span><i>✦</i><span>System architecture</span><i>✦</i><span
            >Developer experience</span
          ><i>✦</i><span>Technical leadership</span><i>✦</i><span>Web platforms</span>
        </div>
      </div>

      <section class="metrics" aria-label="Career impact">
        {
          metrics.map((metric) => (
            <article class={`metric metric-${metric.accent}`} data-glow>
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </article>
          ))
        }
      </section>

      <section id="work" class="section work-section" aria-labelledby="work-title">
        <div class="section-heading">
          <p class="section-index">01 / Selected systems</p>
          <div>
            <h2 id="work-title">The work is internal.<br />The impact isn’t.</h2>
            <p>
              The source is private, but the shape of the problems—and the value of solving them—is
              worth showing.
            </p>
          </div>
        </div>

        <div class="system-list">
          {
            systems.map((system) => (
              <article class="system-card" data-glow>
                <div class="system-number">{system.number}</div>
                <div class="system-copy">
                  <p class="system-kicker">{system.kicker}</p>
                  <h3>{system.title}</h3>
                  <p>{system.description}</p>
                  <ul aria-label={`${system.title} topics`}>
                    {system.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </div>
                <div class="signal-visual" aria-hidden="true">
                  <span>{system.signal}</span>
                  <div class="signal-lines"><i /><i /><i /><i /><i /><i /><i /></div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="experience" class="section experience-section" aria-labelledby="experience-title">
        <div class="section-heading compact">
          <p class="section-index">02 / Experience</p>
          <div>
            <h2 id="experience-title">A career spent making<br />engineering multiply.</h2>
          </div>
        </div>

        <ol class="timeline">
          {
            resume.experience.map((job, index) => (
              <li>
                <div class="timeline-marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
                <div class="timeline-meta">
                  <p>{job.dates}</p>
                  <span>{job.location}</span>
                </div>
                <div class="timeline-content">
                  <p class="company">{job.company}</p>
                  <h3>{job.role}</h3>
                  <ul>
                    {job.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                  {'note' in job && job.note && <p class="timeline-note">{job.note}</p>}
                </div>
              </li>
            ))
          }
        </ol>

        <div class="resume-download">
          <p>Need the traditional version?</p>
          <a class="button button-secondary" href={resume.pdf} download={resume.pdfDownloadName}>
            Download résumé <span aria-hidden="true">↓</span>
          </a>
        </div>
      </section>

      <section id="principles" class="section principles-section" aria-labelledby="principles-title">
        <div class="section-heading compact">
          <p class="section-index">03 / How I work</p>
          <div><h2 id="principles-title">Opinionated about<br />the right things.</h2></div>
        </div>
        <div class="principles-grid">
          {
            principles.map((principle, index) => (
              <article>
                <span>0{index + 1}</span>
                <h3>{principle.title}</h3>
                <p>{principle.body}</p>
              </article>
            ))
          }
        </div>
        <div class="skills-row" aria-label="Skills">
          {resume.skills.map((skill) => <span>{skill}</span>)}
        </div>
      </section>

      <section class="contact-section" aria-labelledby="contact-title">
        <p class="section-index">04 / Contact</p>
        <div class="contact-grid">
          <h2 id="contact-title">Let’s build the thing<br /><em>behind the thing.</em></h2>
          <div>
            <p>
              I’m always interested in thoughtful conversations about platform engineering, AI,
              developer experience, and hard systems problems.
            </p>
            <div class="contact-actions">
              <a class="button button-primary" href={`mailto:${resume.email}`}>
                Email Troy <Fragment set:html={arrow} />
              </a>
              <CopyEmail email={resume.email} client:load />
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div>
        <span>© {new Date().getFullYear()} Troy Rhinehart</span>
        <span>Designed & built with intention.</span>
      </div>
      <nav aria-label="Social links">
        <a href={resume.linkedin.href} rel="me noopener" target="_blank">LinkedIn ↗</a>
        <a href="https://github.com/gingur" rel="me noopener" target="_blank">GitHub ↗</a>
        <a href="#top">Back to top ↑</a>
      </nav>
    </footer>
  </div>

  <script>
    const bindCardGlow = () => {
      document.querySelectorAll<HTMLElement>('[data-glow]').forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const bounds = card.getBoundingClientRect();
          card.style.setProperty('--pointer-x', `${event.clientX - bounds.left}px`);
          card.style.setProperty('--pointer-y', `${event.clientY - bounds.top}px`);
        });
      });
    };

    document.addEventListener('astro:page-load', bindCardGlow);
  </script>
</BaseLayout>
