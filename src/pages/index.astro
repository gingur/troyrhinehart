---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommitField from '../components/CommitField';
import ParticleImage from '../components/ParticleImage';
import { site } from '../config/site';
import { resume } from '../data/resume';

const description = `${resume.name} is a ${resume.title.toLowerCase()} building AI platforms, developer tooling, and web products at scale.`;

const companyDetails = [
  {
    logo: '/logos/attentive.png',
    color: '255,209,0',
    accent: 'yellow',
    label: 'Attentive',
    eyebrow: 'Agentic engineering at organizational scale',
    statement:
      'Building the platform and practices that make AI-assisted engineering useful, observable, and dependable for an entire organization.',
    gap: 3,
    dotRadius: 1.35,
  },
  {
    logo: '/logos/godaddy.png',
    color: '27,219,219',
    accent: 'cyan',
    label: 'GoDaddy',
    eyebrow: 'Thirteen years of products, platforms, and technical leadership',
    statement:
      'From the site builder behind millions of customer websites to a unified AI platform, the through-line was always leverage for the teams building next.',
    gap: 3,
    dotRadius: 1.35,
  },
  {
    logo: '/logos/village-voice.png',
    color: '237,28,36',
    accent: 'red',
    label: 'Village Voice Media',
    eyebrow: 'Where the production story began',
    statement:
      'Learning the whole lifecycle by shipping across the stack—and building shared identity infrastructure for thirteen regional publications.',
    gap: 2,
    dotRadius: 1,
  },
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: resume.name,
  jobTitle: resume.title,
  email: `mailto:${resume.email}`,
  url: new URL('/', Astro.site ?? Astro.url).href,
  sameAs: [resume.linkedin.href, 'https://github.com/gingur'],
  address: { '@type': 'PostalAddress', addressLocality: 'Mesa', addressRegion: 'AZ' },
  knowsAbout: [...resume.skills],
  alumniOf: resume.education.map((entry) => ({
    '@type': 'CollegeOrUniversity',
    name: entry.institution,
  })),
  worksFor: { '@type': 'Organization', name: resume.experience[0].company },
};

const arrow = `
  <svg aria-hidden="true" viewBox="0 0 16 16" fill="none">
    <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`;

const impactSignals = [
  {
    label: 'AI platform',
    value: '11 / 80',
    detail: 'providers / models, one integration point',
  },
  {
    label: 'Delivery health',
    value: '70 → 90%+',
    detail: 'test reliability, with pipelines up to 80% faster',
  },
  {
    label: 'Product reach',
    value: 'Millions',
    detail: 'of customer sites powered by platform architecture',
  },
] as const;
---

<BaseLayout title={`${resume.name} — ${resume.title}`} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <a class="skip-link" href="#top">Skip to main content</a>

  <div class="site-shell">
    <header class="topbar">
      <a class="monogram" href="#top" aria-label="Troy Rhinehart, back to top">
        <span>TR</span><i aria-hidden="true"></i>
      </a>
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="#experience">Experience</a>
        <a href="#activity">Activity</a>
      </nav>
      <div class="header-actions">
        <a class="nav-resume" href="/resume/">Résumé</a>
        <a
          class="nav-cta"
          href={site.links.calendly}
          rel="noopener"
          target="_blank"
        >
          Book 30 Min <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <main id="top" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>

        <div class="hero-kicker reveal reveal-1">
          <p>
            <span class="status-dot" aria-hidden="true"></span>
            Principal Software Engineer
          </p>
          <p>15+ years · Mesa, Arizona</p>
        </div>

        <h1 id="hero-title" class="reveal reveal-2">
          <span>Troy</span>
          <em>Rhinehart</em>
        </h1>

        <div class="hero-content reveal reveal-3">
          <div class="hero-copy">
            <p class="hero-thesis">I build the systems behind ambitious products.</p>
            <p class="hero-intro">
              AI platforms, developer tooling, and web architecture that turn complexity into
              leverage for the teams building next.
            </p>
            <div class="hero-actions">
              <a
                class="button button-primary"
                href={site.links.calendly}
                rel="noopener"
                target="_blank"
              >
                Book 30 Minutes <Fragment set:html={arrow} />
              </a>
              <a class="text-link" href="/resume/">View Résumé</a>
            </div>
          </div>

          <dl class="impact-ledger" aria-label="Selected impact">
            {
              impactSignals.map((signal) => (
                <div>
                  <dt>{signal.label}</dt>
                  <dd>
                    <strong>{signal.value}</strong>
                    <span>{signal.detail}</span>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <a class="hero-scroll" href="#experience">
          <span>Selected experience</span>
          <span aria-hidden="true">↓</span>
        </a>

        <div class="hero-bus" aria-hidden="true">
          <i></i><i></i><i></i>
        </div>
      </section>

      <section id="experience" class="experience-section" aria-labelledby="experience-title">
        <header class="experience-heading">
          <h2 id="experience-title" class="section-index">01 / Experience</h2>
          <p>Selected experience · 2010—Now</p>
        </header>

        <ol class="company-list">
          {
            resume.experience.map((job, index) => {
              const details = companyDetails[index]!;
              return (
                <li class={`company-chapter company-${details.accent}`}>
                  <div class="chapter-rail">
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <p>{job.dates}</p>
                  </div>

                  <figure class="company-visual">
                    <div class="particle-frame">
                      <ParticleImage
                        src={details.logo}
                        size={380}
                        gap={details.gap}
                        dotRadius={details.dotRadius}
                        color={details.color}
                        ariaLabel={`${details.label} particle logo`}
                        client:visible
                      />
                    </div>
                    <figcaption>Move through the mark</figcaption>
                  </figure>

                  <article class="company-story">
                    <p class="company-eyebrow">{details.eyebrow}</p>
                    <h3>{job.company}</h3>
                    <p class="company-role">{job.role}</p>
                    <p class="company-statement">{details.statement}</p>
                    <ul>
                      {job.highlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                    {'note' in job && job.note && <p class="company-note">{job.note}</p>}
                    <p class="company-location">{job.location}</p>
                  </article>
                </li>
              );
            })
          }
        </ol>
      </section>

      <section id="activity" class="activity-section" aria-labelledby="activity-title">
        <header class="activity-heading">
          <p class="section-index">02 / Activity</p>
          <div>
            <h2 id="activity-title">The Work <em>Between the Milestones.</em></h2>
            <p>
              A live signal from the day-to-day: public contribution activity combined across my
              GitHub identities.
            </p>
          </div>
        </header>
        <CommitField client:idle />
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <p class="section-index">03 / Next</p>
        <div class="closing-copy">
          <h2 id="closing-title">Let’s Build Something <em>With Leverage.</em></h2>
          <p>
            If you’re working through a hard platform, product, or engineering-system problem,
            let’s compare notes.
          </p>
        </div>
        <div class="closing-actions">
          <a
            class="button button-primary"
            href={site.links.calendly}
            rel="noopener"
            target="_blank"
          >
            Book 30 Minutes <Fragment set:html={arrow} />
          </a>
          <div>
            <a href={`mailto:${resume.email}`}>Email</a>
            <a href={resume.linkedin.href} rel="me noopener" target="_blank">LinkedIn ↗</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Troy Rhinehart</span>
      <nav aria-label="Footer navigation">
        <a href="/resume/">Résumé</a>
        <a href={site.links.github} rel="me noopener" target="_blank">GitHub ↗</a>
        <a href="#top">Back to top ↑</a>
      </nav>
    </footer>
  </div>
</BaseLayout>
