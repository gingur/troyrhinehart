---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume } from '../data/resume';

const description = `Resume of ${resume.name} — ${resume.title.toLowerCase()} in ${resume.location}. 15+ years in web application architecture, developer experience, and AI.`;

const linkClass =
  'text-neutral-300 underline-offset-4 transition-colors hover:text-neutral-50 hover:underline print:text-neutral-900 print:no-underline';

const sectionHeadingClass =
  'mb-4 text-sm font-semibold uppercase tracking-widest text-neutral-500 print:text-neutral-600';

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: resume.name,
  jobTitle: resume.title,
  email: `mailto:${resume.email}`,
  url: canonical.href,
  sameAs: [resume.linkedin.href],
  address: { '@type': 'PostalAddress', addressLocality: 'Mesa', addressRegion: 'AZ' },
  knowsAbout: [...resume.skills],
  alumniOf: resume.education.map((entry) => ({
    '@type': 'CollegeOrUniversity',
    name: entry.institution,
  })),
  worksFor: { '@type': 'Organization', name: resume.experience[0].company },
};
---

<BaseLayout title={`Resume — ${resume.name}`} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <a class="skip-link" href="#resume-content">Skip to resume</a>

  <main
    id="resume-content"
    tabindex="-1"
    class="resume-page mx-auto max-w-4xl px-6 py-16 print:max-w-none print:px-0 print:py-0 print:text-neutral-900"
  >
    <p class="mb-8 text-sm print:hidden">
      <a class={linkClass} href="/">&larr; troyrhinehart.com</a>
    </p>

    <header class="border-b border-neutral-800 pb-8 print:border-neutral-300">
      <h1 class="text-5xl font-semibold tracking-tight sm:text-6xl">{resume.name}</h1>
      <p class="mt-2 text-xl text-neutral-300 print:text-neutral-700">{resume.title}</p>

      <ul
        class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-base text-neutral-400 print:text-neutral-700"
      >
        <li>{resume.location}</li>
        <li><a class={linkClass} href={`mailto:${resume.email}`}>{resume.email}</a></li>
        <li>
          <a class={linkClass} href={resume.linkedin.href} rel="me noopener" target="_blank">
            {resume.linkedin.label}
          </a>
        </li>
      </ul>

      <p class="resume-summary mt-7 text-lg text-neutral-200 print:text-neutral-800">
        {resume.summary}
      </p>

      <p class="mt-6 print:hidden">
        <a
          class="inline-flex items-center rounded-md border border-neutral-700 px-4 py-2 text-base font-medium text-neutral-200 transition-colors hover:border-neutral-500 hover:text-neutral-50"
          href={resume.pdf}
          download={resume.pdfDownloadName}
        >
          Download PDF
        </a>
      </p>
    </header>

    <section class="mt-10" aria-labelledby="experience">
      <h2 id="experience" class={sectionHeadingClass}>Experience</h2>
      <ol class="space-y-8">
        {
          resume.experience.map((job) => (
            <li class="break-inside-avoid">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-lg font-medium text-neutral-100 print:text-neutral-900">
                  {job.role} · <span class="text-neutral-300 print:text-neutral-800">{job.company}</span>
                </h3>
                <p class="text-base text-neutral-500 print:text-neutral-600">
                  {job.dates} · {job.location}
                </p>
              </div>
              <ul class="mt-3 space-y-2 text-neutral-300 print:text-neutral-800">
                {job.highlights.map((highlight) => (
                  <li class="relative pl-5 before:absolute before:left-0 before:text-neutral-600 before:content-['—']">
                    {highlight}
                  </li>
                ))}
              </ul>
              {'note' in job && job.note && (
                <p class="mt-3 text-sm text-neutral-500 print:text-neutral-600">{job.note}</p>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-10 break-inside-avoid" aria-labelledby="skills">
      <h2 id="skills" class={sectionHeadingClass}>Skills</h2>
      <ul class="flex flex-wrap gap-x-3 gap-y-2 text-neutral-300 print:text-neutral-800">
        {resume.skills.map((skill, index) => (
          <li>{skill}{index < resume.skills.length - 1 && <span class="ml-3 text-neutral-600">·</span>}</li>
        ))}
      </ul>
    </section>

    <section class="mt-10 break-inside-avoid" aria-labelledby="education">
      <h2 id="education" class={sectionHeadingClass}>Education</h2>
      <ul class="space-y-2 text-neutral-300 print:text-neutral-800">
        {resume.education.map((entry) => (
          <li><span class="text-neutral-100 print:text-neutral-900">{entry.credential}</span>{' — '}{entry.institution} · {entry.year}</li>
        ))}
      </ul>
    </section>

    <section class="mt-10 break-inside-avoid" aria-labelledby="awards">
      <h2 id="awards" class={sectionHeadingClass}>Awards</h2>
      <ul class="space-y-2 text-neutral-300 print:text-neutral-800">
        {resume.awards.map((award) => <li>{award}</li>)}
      </ul>
    </section>
  </main>
</BaseLayout>
